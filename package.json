{
  "name": "lumbre-cafe",
  "private": true,
  "version": "1.0.0",
  "description": "Experiencia e-commerce full-stack para una marca argentina ficticia de café de especialidad.",
  "license": "MIT",
  "homepage": "https://lumbre-cafe.odriozolageronimo.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gerodrix/lumbre-cafe.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "test:worker": "node scripts/test-worker.mjs",
    "test:quality": "node scripts/audit-build.mjs",
    "check:cloudflare": "wrangler deploy --dry-run",
    "check": "npm run build && npm run test:worker && npm run test:quality && npm run check:cloudflare",
    "db:generate": "drizzle-kit generate",
    "types:cloudflare": "wrangler types",
    "deploy:cloudflare": "npm run build && wrangler deploy --keep-vars"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "latest",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "latest",
    "wrangler": "^4.128.0"
  }
}
